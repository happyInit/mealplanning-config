{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "node-exporter 기준 VM 접근 상태입니다. 0이면 해당 VM의 인프라 메트릭 수집이 중단된 상태입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {"editorMode": "code", "expr": "up{job=\"node\",instance=~\"$vm\"}", "legendFormat": "{{instance}}", "range": true, "refId": "A"}
      ],
      "title": "VM Health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "VM별 CPU 사용률과 실제 사용 가능한 메모리를 제외한 메모리 사용률입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"},
            "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}
          },
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "id": 2,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\",instance=~\"$vm\"}[$__rate_interval])))", "legendFormat": "{{instance}} CPU", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\",instance=~\"$vm\"} / node_memory_MemTotal_bytes{job=\"node\",instance=~\"$vm\"})", "legendFormat": "{{instance}} Memory", "range": true, "refId": "B"}
      ],
      "title": "CPU & Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "운영에 중요한 루트 파일시스템과 Docker 데이터 디스크의 사용률입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"},
            "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "area"}
          },
          "max": 100,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "id": 3,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",instance=~\"$vm\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=~\"/|/var/lib/docker\"} / node_filesystem_size_bytes{job=\"node\",instance=~\"$vm\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=~\"/|/var/lib/docker\"})",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Disk Health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "VM의 eth0 송수신량과 네트워크 오류 발생률입니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"},
            "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "/.*Errors.*/"},
            "properties": [
              {"id": "unit", "value": "ops"},
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.fillOpacity", "value": 0}
            ]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "id": 4,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum by(instance) (rate(node_network_receive_bytes_total{job=\"node\",instance=~\"$vm\",device=\"eth0\"}[$__rate_interval]))", "legendFormat": "{{instance}} RX", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{job=\"node\",instance=~\"$vm\",device=\"eth0\"}[$__rate_interval]))", "legendFormat": "{{instance}} TX", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum by(instance) (rate(node_network_receive_errs_total{job=\"node\",instance=~\"$vm\",device=\"eth0\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{job=\"node\",instance=~\"$vm\",device=\"eth0\"}[$__rate_interval]))", "legendFormat": "{{instance}} Errors", "range": true, "refId": "C"}
      ],
      "title": "Network Health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 VM에서 선택 기간의 OOM·컨테이너 시작 시각 변경과 현재 cAdvisor 수집 중단 수를 확인합니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(increase(container_oom_events_total{job=\"cadvisor\",image!=\"\",instance=~\"$vm\"}[$__range]))", "instant": true, "legendFormat": "OOM Events", "range": false, "refId": "A"},
        {"editorMode": "code", "expr": "sum(changes(container_start_time_seconds{job=\"cadvisor\",image!=\"\",instance=~\"$vm\"}[$__range]))", "instant": true, "legendFormat": "Restarts", "range": false, "refId": "B"},
        {"editorMode": "code", "expr": "sum(1 - up{job=\"cadvisor\",instance=~\"$vm\"})", "instant": true, "legendFormat": "cAdvisor Down", "range": false, "refId": "C"}
      ],
      "title": "Container Status & Incidents",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "컨테이너가 cgroup CPU 쿼터(CFS quota)에 걸려 스로틀링된 CFS 주기 비율입니다. CPU 사용률이 낮아도 이 값이 높으면, 짧은 순간에 몰린 요청이 쿼터 때문에 대기하고 있다는 뜻입니다(USE의 Saturation).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"},
            "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}
          },
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 25}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 23},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum by(instance, name) (rate(container_cpu_cfs_throttled_periods_total{job=\"cadvisor\",image!=\"\",instance=~\"$vm\"}[$__rate_interval])) / sum by(instance, name) (rate(container_cpu_cfs_periods_total{job=\"cadvisor\",image!=\"\",instance=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU Saturation (Throttling)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["food-budget-app", "infrastructure", "overview"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(up{job=\"node\"}, instance)",
        "includeAll": true,
        "label": "VM",
        "multi": true,
        "name": "vm",
        "options": [],
        "query": {"query": "label_values(up{job=\"node\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "04 Infrastructure Overview",
  "uid": "fba-infrastructure-overview",
  "version": 1,
  "weekStart": ""
}
