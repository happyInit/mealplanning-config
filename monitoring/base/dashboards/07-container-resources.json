      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by(namespace, pod, container) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval])) * 100", "legendFormat": "{{namespace}} / {{pod}} / {{container}}", "range": true, "refId": "A"}],
      "title": "Pod / Container CPU Usage",
      "type": "timeseries"
