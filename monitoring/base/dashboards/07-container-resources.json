      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 namespace의 Pod·컨테이너 CPU 사용률입니다. 기존 Docker 컨테이너 이름 대신 Kubernetes namespace, pod, container 라벨로 구분합니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "CPU %", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 1, "showPoints": "never", "spanNulls": false}, "min": 0, "unit": "percent"}, "overrides": []},
