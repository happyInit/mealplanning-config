      "targets": [{"editorMode": "code", "expr": "sum by(namespace, pod, container) (rate(container_fs_reads_bytes_total{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval]) + rate(container_fs_writes_bytes_total{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval]))", "legendFormat": "{{namespace}} / {{pod}} / {{container}}", "range": true, "refId": "A"}],
