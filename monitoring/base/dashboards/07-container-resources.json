      "targets": [
        {"editorMode": "code", "expr": "sum by(namespace, pod) (rate(container_network_receive_bytes_total{namespace=~\"$namespace\",pod=~\"$pod\",container=\"POD\"}[$__rate_interval]))", "legendFormat": "{{namespace}} / {{pod}} RX", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by(namespace, pod) (rate(container_network_transmit_bytes_total{namespace=~\"$namespace\",pod=~\"$pod\",container=\"POD\"}[$__rate_interval]))", "legendFormat": "{{namespace}} / {{pod}} TX", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum by(namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\"}[$__range]))", "legendFormat": "{{namespace}} / {{pod}} Restarts", "range": true, "refId": "C"}
