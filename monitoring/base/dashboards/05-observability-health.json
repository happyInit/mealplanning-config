        {
          "editorMode": "code",
          "expr": "sum(rate(tempodb_compaction_errors_total{job=~\".*tempo.*\"}[$__rate_interval])) + sum(rate(tempodb_retention_errors_total{job=~\".*tempo.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Backend Errors /s",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Tempo Doctor",
      "type": "stat"
