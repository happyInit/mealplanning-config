      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "전체 요청 중 5xx가 아닌 응답의 비율입니다. 요청이 없는 구간은 NO TRAFFIC으로 구분합니다.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "-1": {
                  "color": "gray",
                  "text": "NO TRAFFIC"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "noValue": "NO TRAFFIC",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "((1 - (sum(rate(http_request_duration_highr_seconds_count{namespace=\"app\",service=~\"$service\",handler=~\"$route\",status=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_request_duration_highr_seconds_count{namespace=\"app\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])), 0.000001))) and on() (sum(rate(http_request_duration_highr_seconds_count{namespace=\"app\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])) > 0)) or on() vector(-1)",
          "legendFormat": "Non-5xx Success",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Non-5xx Success",
      "type": "stat"
    },
